---
import "@/styles/global.css";
import BaseHead from "@/components/fundations/head/BaseHead.astro";
import contentOverrides from "@/data/content-overrides.json";
// Seções globais
import Footer from "@/components/global/Footer.astro";
import Navigation from "@/components/global/Navigation.astro";
import ScrollAnimations from "@/components/global/ScrollAnimations.astro";
import EditModeButton from "@/components/global/EditModeButton";
import EditLinkModal from "@/components/global/EditLinkModal";
import ApplyContentOverrides from "@/components/global/ApplyContentOverrides.astro";

/**
 * Título e descrição são opcionais: sem eles, o site usa
 * os valores padrão de src/data/site.ts.
 *
 * Removidos deste layout:
 * - CustomCursor: não funciona no celular e atrapalha acessibilidade.
 * - PageLoader: impunha ~3,3s de espera artificial antes do conteúdo.
 */
interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
---

<html lang="pt-BR" class="dark scroll-smooth">
  <head>
    <BaseHead {title} {description} {image} />
    <script is:inline define:vars={{ contentOverrides }}>
      window.__CONTENT_OVERRIDES__ = contentOverrides;
    </script>
  </head>
  <body class="bg-white dark:bg-base-950 min-h-svh">
    <ApplyContentOverrides />
    <ScrollAnimations />
    <div id="page-content">
      <Navigation />
      <main class="pb-12"><slot /></main>
      <Footer />
      <div aria-hidden="true" class="h-[12vh]"></div>
    </div>
    <!-- Modo de edição: só existe em desenvolvimento, some no site publicado. -->
    <EditModeButton client:load />
    <EditLinkModal client:load />
  </body>
</html>
