---
import { site } from "@/data/site";

// /system/* é referência interna do design system: acessível, mas fora
// do índice. O noindex só funciona se o robots.txt deixar o buscador
// ler a página — por isso /system/ não tem Disallow lá.
const indexar = !Astro.url.pathname.startsWith("/system/");
const robots = indexar ? "index, follow" : "noindex, nofollow";
---

<!-- Meta tags básicas -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="theme-color" content="#0a0a0a" />
<meta name="robots" content={robots} />
<meta name="googlebot" content={robots} />

<!-- Verificação de propriedade no Google Search Console -->
{
  site.verificacaoGoogle && (
    <meta name="google-site-verification" content={site.verificacaoGoogle} />
  )
}
