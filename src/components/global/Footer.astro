---
// Assets
import Logo from "@/components/assets/Logo.astro";
// Foundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { contatos, colofao } from "@/data/site";

/**
 * Rodapé com colofão.
 *
 * Declarar a stack, o método (pair programming com IA) e o template de
 * origem é transparência deliberada: quem avalia respeita mais quem
 * mostra como fez do que quem finge que nasceu pronto.
 */
const year = new Date().getFullYear();

const creditos = [colofao.repositorio, colofao.template];
---

<footer class="mt-12 border-t border-base-200 py-10 dark:border-base-800">
  <Wrapper variant="standard">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-4 lg:gap-8">
      <!-- Marca -->
      <div
        class="flex items-center gap-2 font-mono text-xs tracking-tight text-base-500 dark:text-base-400"
      >
        {year}
        <Logo />
      </div>

      <!-- Colofão -->
      <div class="lg:col-span-2">
        <Text
          tag="p"
          variant="textXS"
          class="font-mono uppercase tracking-wide text-base-500 dark:text-base-400"
        >
          Sobre este site
        </Text>
        <Text
          tag="p"
          variant="textSM"
          class="mt-3 max-w-prose text-base-600 dark:text-base-300"
        >
          {colofao.stack}
        </Text>
        <Text
          tag="p"
          variant="textSM"
          class="mt-2 max-w-prose text-base-600 dark:text-base-300"
        >
          {colofao.metodo}
        </Text>

        <div class="mt-4 flex flex-wrap gap-6">
          {
            creditos.map((c) => (
              <a
                href={c.href}
                target="_blank"
                rel="noopener noreferrer"
                class="font-mono text-xs uppercase tracking-wide text-base-500 underline decoration-base-700 underline-offset-4 transition-colors hover:text-accent-400 hover:decoration-accent-500 dark:text-base-400"
              >
                {c.texto}
              </a>
            ))
          }
        </div>
      </div>

      <!-- Contato -->
      <div class="flex flex-col gap-3 lg:items-end">
        {
          contatos.map((link) => (
            <a
              href={link.href}
              target={link.href.startsWith("mailto:") ? undefined : "_blank"}
              rel={link.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
              class="font-mono text-xs uppercase tracking-wide text-base-500 transition-colors hover:text-accent-400 dark:text-base-400"
            >
              {link.texto}
            </a>
          ))
        }
      </div>
    </div>
  </Wrapper>
</footer>
