---
// Assets
import Logo from "@/components/assets/Logo.astro";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import EditableLink from "@/components/global/EditableLink.astro";
import { getContent } from "@/lib/getContent";
import { site } from "@/data/site";

const links = [
  { href: "/#projetos", text: "Projetos" },
  { href: "/#trabalho", text: "Trabalho" },
  { href: "/#stack", text: "Stack" },
];
---

<nav class="bg-white dark:bg-base-950 fixed top-0 z-10 w-full">
  <Wrapper variant="standard" class="py-2">
    <div class="grid grid-cols-3 lg:grid-cols-4 items-start">
      <a href="/" class="group -mt-1 flex">
        <Logo
          class="font-mono text-base-900 dark:text-white text-xs tracking-tight transition-colors group-hover:text-accent-700 dark:group-hover:text-accent-400"
        />
      </a>
      <Text
        tag="p"
        variant="textXS"
        class="font-mono text-base-500 dark:text-base-400 tracking-tight"
      >
        <span data-editable="nav.location">{getContent("nav.location", site.local)}</span><br />
        <span data-editable="nav.role">{getContent("nav.role", "python · automação")}</span>
      </Text>
      <div class="hidden lg:flex gap-8 text-sm items-center">
        {
          links.map((link) => (
            <a
              href={link.href}
              class="font-mono uppercase tracking-wide text-base-500 dark:text-base-400 text-xs transition-colors hover:text-accent-700 dark:hover:text-accent-400"
            >
              {link.text}
            </a>
          ))
        }
      </div>
      <EditableLink
        linkKey="nav.contact"
        href="/#contato"
        class="font-mono uppercase tracking-wide text-base-500 dark:text-base-400 text-xs ml-auto transition-colors hover:text-accent-700 dark:hover:text-accent-400"
      >
        {getContent("nav.contact", "Contato")}
      </EditableLink>
    </div>
  </Wrapper>
</nav>
