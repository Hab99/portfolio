---
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { projectItems } from "@/data/portfolio";
import { getContent } from "@/lib/getContent";

// Mesmo eixo e mesma hierarquia da seção Trabalho — ver Work.astro.
const projectsEyebrowDefault = "Entregas técnicas";
---

<section class="scroll-mt-32" id="projetos">
  <Wrapper variant="standard" class="py-12 lg:py-24">
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-4 items-baseline">
      <Text
        tag="p"
        variant="textXS"
        class="font-mono uppercase tracking-wide text-base-500 dark:text-base-400"
        data-editable="sections.projects.eyebrow"
        >{getContent("sections.projects.eyebrow", projectsEyebrowDefault)}</Text
      >
      <Text
        tag="h2"
        variant="displayMD"
        class="font-semibold leading-tight tracking-tighter lg:col-span-3 text-base-900 dark:text-white"
        data-editable="sections.projects.title"
      >
        {getContent("sections.projects.title", "Projetos")}
      </Text>
    </div>

    <div class="mt-12 border-t border-base-200 dark:border-base-800">
      {
        projectItems.map((project) => (
          <a
            href={`/projeto/${project.slug}`}
            class="group block border-b border-base-200 dark:border-base-800 py-10 transition-colors hover:bg-base-50 dark:hover:bg-base-900/40"
          >
            <div class="grid grid-cols-1 gap-4 lg:grid-cols-4 lg:gap-8 items-baseline">
              <Text
                tag="p"
                variant="textXS"
                class="font-mono uppercase tracking-wide text-base-500 dark:text-base-400"
                data-editable={`projects.${project.slug}.year`}
              >
                {getContent(`projects.${project.slug}.year`, project.year)}
              </Text>

              <div class="lg:col-span-2">
                <Text
                  tag="h3"
                  variant="displayXS"
                  class="font-semibold leading-tight tracking-tight text-base-900 dark:text-white transition-colors group-hover:text-accent-700 dark:group-hover:text-accent-400"
                  data-editable={`projects.${project.slug}.title`}
                >
                  {getContent(`projects.${project.slug}.title`, project.title)}
                </Text>
                <Text
                  tag="p"
                  variant="textSM"
                  class="mt-3 max-w-prose text-base-600 dark:text-base-300"
                  data-editable={`projects.${project.slug}.description`}
                >
                  {getContent(`projects.${project.slug}.description`, project.description)}
                </Text>

                {/* Selo: sinaliza ao avaliador técnico onde há código para abrir. */}
                {project.repo && (
                  <span class="mt-4 inline-flex items-center gap-2 border border-accent-500/40 px-2.5 py-1 font-mono text-[0.65rem] uppercase tracking-wide text-accent-400">
                    <span aria-hidden="true" class="inline-block size-1.5 rounded-full bg-accent-500" />
                    Código público
                  </span>
                )}
              </div>

              <div class="flex items-baseline gap-3 lg:justify-end">
                <Text
                  tag="p"
                  variant="textXS"
                  class="font-mono uppercase tracking-wide text-base-500 dark:text-base-400"
                  data-editable={`projects.${project.slug}.category`}
                >
                  {getContent(`projects.${project.slug}.category`, project.category)}
                </Text>
                <span
                  aria-hidden="true"
                  class="text-base-400 transition-transform duration-300 group-hover:translate-x-1 dark:text-base-400"
                >
                  →
                </span>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </Wrapper>
</section>
