---
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

/**
 * "O que eu resolvo" — os quatro problemas que o Guilherme ataca.
 *
 * Vem logo depois da primeira dobra porque responde a pergunta que o
 * recrutador faz antes de olhar projeto: "esse cara serve pra quê?".
 */
const pilares = [
  {
    numero: "01",
    titulo: "Ambientes sem API e sem DOM",
    texto:
      "Terminal de mainframe (IMS/PCOM) dentro de sessão Citrix, aplicações legadas de desktop, sistemas virtualizados. Sem DOM para inspecionar e sem banco acessível, a tela é a única superfície de contato: navegação por tecla, âncora visual com OpenCV, leitura por OCR e controle de janelas por chamada nativa à Win32 API.",
  },
  {
    numero: "02",
    titulo: "Portais sem integração",
    texto:
      "Quando o sistema não oferece API, a interface vira a porta de entrada. Automação de portais bancários e sistemas web com Playwright e Selenium, isolando navegação de regra de negócio para o robô não quebrar a cada mudança de layout.",
  },
  {
    numero: "03",
    titulo: "Documentos em escala",
    texto:
      "Extração, leitura e classificação de documentos em lote com OCR e parsing resiliente. PDF e imagem viram dado estruturado que o processo seguinte consegue consumir — com guarda de duplicados e retomada por checkpoint, porque lote longo é interrompido no meio.",
  },
  {
    numero: "04",
    titulo: "Robô que fica de pé depois do deploy",
    texto:
      "Respondo pela operação diária dos robôs em produção: processamento das cargas de toda a carteira, monitoramento, tratamento das falhas do dia e reprocessamento em lote. Construir e sustentar o mesmo robô muda o que se constrói.",
  },
];
---

<section class="scroll-mt-32" id="solucoes">
  <Wrapper variant="standard" class="py-12 lg:py-24">
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-4 items-baseline">
      <Text
        tag="p"
        variant="textXS"
        class="font-mono uppercase tracking-wide text-base-500 dark:text-base-400"
      >
        Atuação
      </Text>
      <Text
        tag="h2"
        variant="displayMD"
        class="font-semibold leading-tight tracking-tighter lg:col-span-3 text-base-900 dark:text-white"
      >
        O que eu resolvo
      </Text>
    </div>

    <div class="mt-12 border-t border-base-200 dark:border-base-800">
      {
        pilares.map((pilar) => (
          <article class="border-b border-base-200 dark:border-base-800 py-10">
            <div class="grid grid-cols-1 gap-4 lg:grid-cols-4 lg:gap-8 items-baseline">
              <Text
                tag="p"
                variant="textXS"
                class="font-mono uppercase tracking-wide text-base-500 dark:text-base-400"
              >
                {pilar.numero}
              </Text>

              <Text
                tag="h3"
                variant="displayXS"
                class="font-semibold leading-tight tracking-tight text-base-900 dark:text-white"
              >
                {pilar.titulo}
              </Text>

              <Text
                tag="p"
                variant="textSM"
                class="lg:col-span-2 max-w-prose text-base-600 dark:text-base-300"
              >
                {pilar.texto}
              </Text>
            </div>
          </article>
        ))
      }
    </div>
  </Wrapper>
</section>
