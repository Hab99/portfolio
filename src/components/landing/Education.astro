---
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { getContent } from "@/lib/getContent";

const education = [
  {
    period: "2026 — Cursando",
    title: "Senac São Paulo",
    description:
      "Tecnólogo em Análise e Desenvolvimento de Sistemas. Aprofundamento em boas práticas de desenvolvimento, princípios SOLID, padrões de projeto e refatoração.",
    category: "Graduação",
  },
  {
    period: "2024 — 2025",
    title: "Certificações técnicas",
    description:
      "Python Essentials 1 (Cisco), Introduction to Containers, Introduction to Amazon API Gateway e Fundamentos do Hardware do Computador.",
    category: "Certificações",
  },
];
const educationEyebrowDefault = "Formação";
---

<section class="scroll-mt-32" id="educacao">
  <Wrapper variant="standard" class="py-12 lg:py-24">
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-4 items-baseline">
      <Text
        tag="p"
        variant="textXS"
        class="font-mono uppercase tracking-wide text-base-500 dark:text-base-400"
        data-editable="sections.education.eyebrow"
      >
        {getContent("sections.education.eyebrow", educationEyebrowDefault)}
      </Text>

      <Text
        tag="h2"
        variant="displayMD"
        class="font-semibold leading-tight tracking-tighter lg:col-span-3 text-base-900 dark:text-white"
        data-editable="sections.education.title"
      >
        {getContent("sections.education.title", "Educação")}
      </Text>
    </div>

    <div class="mt-12 border-t border-base-200 dark:border-base-800">
      {
        education.map((item, index) => (
          <article class="border-b border-base-200 dark:border-base-800 py-10">
            <div class="grid grid-cols-1 gap-4 lg:grid-cols-4 lg:gap-8 items-baseline">
              <Text
                tag="p"
                variant="textXS"
                class="font-mono uppercase tracking-wide text-base-500 dark:text-base-400"
                data-editable={`education.${index}.period`}
              >
                {getContent(`education.${index}.period`, item.period)}
              </Text>

              <div class="lg:col-span-2">
                <Text
                  tag="h3"
                  variant="displayXS"
                  class="font-semibold leading-tight tracking-tight text-base-900 dark:text-white"
                  data-editable={`education.${index}.title`}
                >
                  {getContent(`education.${index}.title`, item.title)}
                </Text>
                <Text
                  tag="p"
                  variant="textSM"
                  class="mt-3 max-w-prose text-base-600 dark:text-base-300"
                  data-editable={`education.${index}.description`}
                >
                  {getContent(`education.${index}.description`, item.description)}
                </Text>
              </div>

              <Text
                tag="p"
                variant="textXS"
                class="font-mono uppercase tracking-wide text-base-500 dark:text-base-400 lg:text-right"
                data-editable={`education.${index}.category`}
              >
                {getContent(`education.${index}.category`, item.category)}
              </Text>
            </div>
          </article>
        ))
      }
    </div>
  </Wrapper>
</section>
