---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CaseDetail from "@/components/landing/CaseDetail.astro";
import { getWorkItem, workItems } from "@/data/portfolio";
import { site } from "@/data/site";

export function getStaticPaths() {
  return workItems.map((item) => ({
    params: { slug: item.slug },
  }));
}

const { slug } = Astro.params;
const item = getWorkItem(slug!);

if (!item) {
  return Astro.redirect("/404");
}
const base = (Astro.site ?? new URL(site.url)).href.replace(/\/$/, "");
const breadcrumb = [
  { nome: "Início", url: `${base}/` },
  { nome: "Trabalho", url: `${base}/#trabalho` },
  { nome: item.title, url: `${base}/trabalho/${item.slug}/` },
];
---

<BaseLayout {breadcrumb} title={`${item.title} — ${item.category}`} description={item.description}>
  <CaseDetail
    item={item}
    contentPrefix={`work.${item.slug}`}
    backHref="/#trabalho"
    backLabel="Voltar para Trabalho"
    eyebrow="Trajetória"
  />
</BaseLayout>
