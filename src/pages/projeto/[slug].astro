---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CaseDetail from "@/components/landing/CaseDetail.astro";
import { getProjectItem, projectItems } from "@/data/portfolio";
import { site } from "@/data/site";

export function getStaticPaths() {
  return projectItems.map((item) => ({
    params: { slug: item.slug },
  }));
}

const { slug } = Astro.params;
const item = getProjectItem(slug!);

if (!item) {
  return Astro.redirect("/404");
}
const base = (Astro.site ?? new URL(site.url)).href.replace(/\/$/, "");
const breadcrumb = [
  { nome: "Início", url: `${base}/` },
  { nome: "Projetos", url: `${base}/#projetos` },
  { nome: item.title, url: `${base}/projeto/${item.slug}/` },
];
---

<BaseLayout {breadcrumb} title={item.title} description={item.description}>
  <CaseDetail
    item={item}
    contentPrefix={`projects.${item.slug}`}
    backHref="/#projetos"
    backLabel="Voltar para Projetos"
    eyebrow="Projeto"
  />
</BaseLayout>
